      "item": [
        {
          "id": "03057211-25dd-47a8-8b1f-167a28deaeb6",
          "name": "Start import",
          "request": {
            "name": "Start import",
            "description": {
              "content": "Trigger the run of an existing workspace-scoped import programmatically.\n\nThe following types of imports can be triggered: [URL](https://documentation.bloomreach.com/data-hub/docs/url-imports), [File storage\n(GCS, S3, SFTP)](https://documentation.bloomreach.com/data-hub/docs/file-storage-imports), [Data warehouse](https://documentation.bloomreach.com/data-hub/docs/data-warehouse-imports).\n\nIf you're using a URL or File storage (GCS, SFTP) import, you can\noverride its original path or URL. When overridden, the path\napplies only to this specific run and does not modify the import\ndefinition.\n\nUse this endpoint with a [**workspace** API key](https://documentation.bloomreach.com/data-hub/reference/data-hub-api-prerequisites) (issued in\nWorkspace settings → Access management → API). The\n`{workspaceId}` in the path must match the workspace the API key\nwas issued for.\n\n### Authorization\n- **Access type:** Private access (workspace API key)\n- **Permission required:** Imports → Allow trigger imports\n\n### Limitations\n- Cannot trigger **Copy & paste** or **File upload** imports.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "v2",
                "workspaces",
                ":workspaceId",
                "imports",
                ":import_id",
                "start"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspaceId",
                  "description": "(Required) The ID of your Bloomreach Engagement workspace. Must match the\nworkspace the API key was issued for; otherwise the request is\nrejected with HTTP 403.\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "import_id",
                  "description": "(Required) The ID of an existing import in the workspace."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"path\": \"<string>\",\n  \"test_connection\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
