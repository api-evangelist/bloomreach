        {
          "id": "9edc9de1-7ec0-4804-919d-dc13e7803480",
          "name": "Run an indexing job",
          "request": {
            "name": "Run an indexing job",
            "description": {
              "content": "Trigger an indexing job to [update the catalog's index](https://documentation.bloomreach.com/discovery/docs/promoting-changes-viewing-jobs#3-update-catalogs-index).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_name",
                "catalogs",
                ":catalog_name",
                "environments",
                ":environment_name",
                "indexes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_name",
                  "description": "(Required) Your unique account name."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "catalog_name",
                  "description": "(Required) \"Catalog name\" is also called domain key. Use the same value as your domain key in your search API requests."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "environment_name",
                  "description": "(Required) The type of environment you want to use for the request (Production/Staging)."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "Optionally triggers a full index refresh, in which all products in the catalog are reindexed with the latest configuration.\n\nThis only affects products that were already existing and indexed in the feed. Any newly ingested products will not be affected.",
                "key": "Index-Refresh",
                "value": "<boolean>"
              },
              {
                "disabled": false,
                "description": "Optionally ignore any count drops that occur during the job, allowing the index to be updated even if the number of products drops below the allowed threshold.",
                "key": "BR-Ignore-Document-Count-Drop",
                "value": "<boolean>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
